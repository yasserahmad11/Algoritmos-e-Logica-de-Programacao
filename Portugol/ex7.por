programa {
  funcao inicio() {
    real lado1, lado2, perimetro

    escreva("Digite o valor de um dos lados de um retângulo: ")
    leia(lado1)
    escreva("Digite o valor do outro lado desse retângulo: ")
    leia(lado2)

    perimetro = (lado1 * 2) + (lado2 * 2)

    escreva("Perímetro desse Retângulo: ", perimetro)
  }
}
